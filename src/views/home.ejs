<%- include('partials/header') %>
<main class="page-main home-page">
    <section class="hero-section">
        <span class="eyebrow">Community & Impact</span>
        <h1 class="page-title"><%= title %></h1>
        <h2 class="hero-tagline">Welcome to the CSE 340 Service Network!</h2>
        <p class="hero-lead">
            Our mission is to promote service across the world by connecting volunteers with high-impact service opportunities in their community.
        </p>
        <div class="hero-actions">
            <a href="/projects" class="btn btn-primary">View Projects</a>
            <a href="/organizations" class="btn btn-secondary">Partner Organizations</a>
        </div>
    </section>

    <section class="banner-section">
        <div class="logo-card">
            <img class="main-logo" src="/images/cse340-service-network.png" alt="CSE 340 Service Network Logo">
        </div>
    </section>
</main>
<%- include('partials/footer') %>
