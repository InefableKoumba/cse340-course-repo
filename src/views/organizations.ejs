<%- include('partials/header') %>
<main class="page-main organizations-page">
    <div class="page-header">
        <h1 class="page-title"><%= title %></h1>
        <p class="page-description">We collaborate with trusted local and global non-profit partners to create meaningful community change:</p>
    </div>

    <div class="organizations-grid">
        <% if (organizations && organizations.length > 0) { %>
            <% organizations.forEach(organization => { %>
                <article class="organization-card">
                    <div class="org-image-wrapper">
                        <a href="/organization/<%= organization.organization_id %>">
                            <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                        </a>
                    </div>
                    <div class="org-content">
                        <h2 class="org-title"><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></h2>
                        <p class="org-desc"><%= organization.description %></p>
                        <div class="org-contact">
                            <span class="contact-label">Contact:</span>
                            <a href="mailto:<%= organization.contact_email %>" class="contact-link"><%= organization.contact_email %></a>
                        </div>
                        <div class="card-action">
                            <a href="/organization/<%= organization.organization_id %>" class="btn btn-primary btn-sm">View Organization</a>
                        </div>
                    </div>
                </article>
            <% }); %>
        <% } else { %>
            <p>No organizations found.</p>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>