<%- include('partials/header') %>
<main class="page-main categories-page">
    <div class="page-header">
        <h1 class="page-title"><%= title %></h1>
        <p class="page-description">Explore opportunities categorized by interest to discover how your unique passions and talents can best serve others:</p>
    </div>

    <div class="categories-grid">
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <article class="category-card">
                    <div class="category-icon">
                        <a href="/category/<%= category.category_id %>"><%= category.icon %></a>
                    </div>
                    <h2 class="category-title">
                        <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                    </h2>
                    <p class="category-desc"><%= category.description %></p>
                    <div class="category-card-footer">
                        <span class="category-tag"><%= category.project_count !== undefined ? category.project_count : 0 %> Active Projects</span>
                        <a href="/category/<%= category.category_id %>" class="btn btn-primary btn-sm">View Category</a>
                    </div>
                </article>
            <% }); %>
        <% } else { %>
            <p>No categories found.</p>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>
