<%- include('partials/header') %>
<main class="page-main new-category-page">
    <div class="page-header">
        <h1 class="page-title"><%= title %></h1>
        <p class="page-description">Add a new category to group service projects and volunteer opportunities.</p>
    </div>

    <% if (errors && errors.length > 0) { %>
        <div class="alert-box alert-error" role="alert">
            <h2 class="alert-title">Please correct the following errors:</h2>
            <ul class="alert-list">
                <% errors.forEach(err => { %>
                    <li><%= err %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <div class="form-container">
        <form action="/new-category" method="POST" class="category-form" novalidate>
            <div class="form-group">
                <label for="name" class="form-label">Category Name</label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    class="form-control" 
                    value="<%= formData && formData.name ? formData.name : '' %>" 
                    required 
                    maxlength="100"
                    placeholder="e.g. Environmental, Disaster Relief"
                >
                <span class="field-hint">Required. Maximum 100 characters.</span>
            </div>

            <div class="form-group">
                <label for="description" class="form-label">Description</label>
                <textarea 
                    id="description" 
                    name="description" 
                    class="form-control" 
                    rows="4" 
                    placeholder="Describe the focus and goals of this category..."
                ><%= formData && formData.description ? formData.description : '' %></textarea>
                <span class="field-hint">Optional overview of this category's service opportunities.</span>
            </div>

            <div class="form-actions">
                <a href="/categories" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Create Category</button>
            </div>
        </form>
    </div>
</main>
<%- include('partials/footer') %>
