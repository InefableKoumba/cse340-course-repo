<%- include('partials/header') %>
<main class="page-main edit-project-page">
    <div class="page-header">
        <h1 class="page-title"><%= title %></h1>
        <p class="page-description">Update the details for this service opportunity below.</p>
    </div>

    <% 
        // Format date to YYYY-MM-DD for standard HTML5 <input type="date">
        let dateValue = '';
        if (project && project.date) {
            const d = new Date(project.date);
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            dateValue = `${year}-${month}-${day}`;
        }
    %>

    <div class="form-container">
        <form action="/edit-project/<%= project.project_id %>" method="POST" class="project-form">
            <div class="form-group">
                <label for="title" class="form-label">Project Title</label>
                <input 
                    type="text" 
                    id="title" 
                    name="title" 
                    class="form-control" 
                    value="<%= project.title %>" 
                    required 
                    placeholder="Enter project title"
                >
            </div>

            <div class="form-group">
                <label for="organization_id" class="form-label">Sponsoring Organization</label>
                <select id="organization_id" name="organization_id" class="form-control" required>
                    <option value="">-- Select an Organization --</option>
                    <% organizations.forEach(org => { %>
                        <option 
                            value="<%= org.organization_id %>" 
                            <%= Number(org.organization_id) === Number(project.organization_id) ? 'selected' : '' %>
                        >
                            <%= org.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="date" class="form-label">Project Date</label>
                    <input 
                        type="date" 
                        id="date" 
                        name="date" 
                        class="form-control" 
                        value="<%= dateValue %>" 
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="location" class="form-label">Location</label>
                    <input 
                        type="text" 
                        id="location" 
                        name="location" 
                        class="form-control" 
                        value="<%= project.location %>" 
                        required 
                        placeholder="e.g. 123 Community Way, City"
                    >
                </div>
            </div>

            <div class="form-group">
                <label for="description" class="form-label">Description</label>
                <textarea 
                    id="description" 
                    name="description" 
                    class="form-control" 
                    rows="5" 
                    required 
                    placeholder="Describe the service project and volunteer duties..."
                ><%= project.description %></textarea>
            </div>

            <div class="form-actions">
                <a href="/project/<%= project.project_id %>" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</main>
<%- include('partials/footer') %>
