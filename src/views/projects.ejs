<%- include('partials/header') %>
<main class="page-main projects-page">
    <div class="page-header">
        <h1 class="page-title"><%= title %></h1>
        <p class="page-description">Get involved today! Check out these upcoming opportunities to serve and make an immediate impact:</p>
    </div>

    <div class="projects-grid">
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <% 
                   const formattedDate = new Date(project.date).toLocaleDateString('en-US', {
                       year: 'numeric',
                       month: 'long',
                       day: 'numeric'
                   });
                %>
                <article class="project-card">
                    <div class="project-badge"><%= project.organization_name %></div>
                    <h2 class="project-title"><%= formattedDate %>: <%= project.title %> (<%= project.organization_name %>)</h2>
                    <p class="project-desc"><%= project.description %></p>
                    <div class="project-meta">
                        <span>📍 <%= project.location %></span>
                        <span>📅 <%= formattedDate %></span>
                    </div>
                </article>
            <% }); %>
        <% } else { %>
            <p>No service projects found.</p>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>