<%- include('partials/header') %>
<main class="page-main projects-page">
    <div class="page-header">
        <h1 class="page-title"><%= title %></h1>
        <p class="page-description">Get involved today! Check out these upcoming opportunities to serve and make an immediate impact:</p>
    </div>

    <div class="projects-grid">
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <% 
                   const formattedDate = new Date(project.date).toLocaleDateString('en-US', {
                       year: 'numeric',
                       month: 'long',
                       day: 'numeric'
                   });
                %>
                <article class="project-card">
                    <div class="project-badge">
                        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                    </div>
                    <h2 class="project-title">
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    </h2>
                    <p class="project-org">
                        Sponsored by: <a href="/organization/<%= project.organization_id %>" class="org-inline-link"><%= project.organization_name %></a>
                    </p>
                    <p class="project-desc"><%= project.description %></p>
                    <div class="project-meta">
                        <span>📍 <%= project.location %></span>
                        <span>📅 <%= formattedDate %></span>
                    </div>
                    <div class="card-action">
                        <a href="/project/<%= project.project_id %>" class="btn btn-primary btn-sm">View Project</a>
                    </div>
                </article>
            <% }); %>
        <% } else { %>
            <p>No upcoming service projects found.</p>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>