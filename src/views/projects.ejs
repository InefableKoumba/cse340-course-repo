<%- include('partials/header') %>
<main class="page-main projects-page">
    <div class="page-header">
        <h1 class="page-title"><%= title %></h1>
        <p class="page-description">Get involved today! Check out these upcoming opportunities to serve and make an immediate impact:</p>
    </div>

    <div class="projects-grid">
        <article class="project-card">
            <div class="project-badge">Environmental</div>
            <h2 class="project-title">Park Cleanup Initiative</h2>
            <p class="project-desc">Join us to clean up local community parks, plant native flora, clear litter, and make public spaces safe and vibrant for families.</p>
            <div class="project-meta">
                <span>📍 Riverside City Park</span>
                <span>🕒 Saturday, 9:00 AM - 1:00 PM</span>
            </div>
        </article>

        <article class="project-card">
            <div class="project-badge">Food Relief</div>
            <h2 class="project-title">Community Food Drive</h2>
            <p class="project-desc">Help collect, sort, package, and distribute nutritious food and pantry essentials to local families and shelters in need.</p>
            <div class="project-meta">
                <span>📍 Central Community Center</span>
                <span>🕒 Bi-weekly Wednesdays, 4:00 PM</span>
            </div>
        </article>

        <article class="project-card">
            <div class="project-badge">Education</div>
            <h2 class="project-title">After-School Tutoring</h2>
            <p class="project-desc">Volunteer to mentor and tutor K-12 students in math, science, reading, and basic computer programming literacy.</p>
            <div class="project-meta">
                <span>📍 Westside Public Library</span>
                <span>🕒 Tuesdays & Thursdays, 3:30 PM</span>
            </div>
        </article>
    </div>
</main>
<%- include('partials/footer') %>